# Multi-stage build for React/Vite frontend

# Build args
# vite 7.x requires Node >=20.19
ARG NODE_VERSION=20

# Stage 1: Build
FROM node:${NODE_VERSION}-alpine as builder

WORKDIR /build

# Copy package files
COPY frontend/web/package*.json ./

# Install dependencies
RUN npm ci  # build stage needs devDependencies (vite) — final image is nginx-only

# Copy source code
COPY frontend/web .

# Build arguments for environment variables (VITE_ prefix required by Vite bundler)
ARG VITE_APP_ENV=production
ARG VITE_API_URL
ARG VITE_WS_URL
ARG VITE_APP_VERSION

# Set environment variables for build
ENV VITE_APP_ENV=${VITE_APP_ENV}
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_WS_URL=${VITE_WS_URL}
ENV VITE_APP_VERSION=${VITE_APP_VERSION}

# Build the application
RUN npm run build

# Stage 2: Production server
FROM nginx:alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Copy built files from builder
COPY --from=builder /build/dist /usr/share/nginx/html

# Keep the stock nginx.conf (it globs /etc/nginx/conf.d/*.conf).
# The reverse-proxy infrastructure/docker/nginx/nginx.conf is the GATEWAY config
# (upstreams backend:8000 / frontend:3000) and must NOT be baked into this static
# image — doing so was the T0.2 bug: it overrode the stock http{} (dropping the
# conf.d include) so neither default.conf nor the security headers ever loaded.
#
# Security headers live in a non-globbed snippets/ path so they are applied exactly
# once, via an explicit `include` inside the single server block below (avoids the
# nginx add_header inheritance trap of loading them at http level via conf.d).
COPY infrastructure/docker/nginx/conf.d/security-headers.conf /etc/nginx/snippets/security-headers.conf

# Single SPA server block (static serving). Exactly one server{} in the image.
RUN printf '%s\n' \
    'server {' \
    '    listen 80;' \
    '    server_name _;' \
    '    root /usr/share/nginx/html;' \
    '    index index.html index.htm;' \
    '' \
    '    include /etc/nginx/snippets/security-headers.conf;' \
    '' \
    '    gzip on;' \
    '    gzip_vary on;' \
    '    gzip_min_length 1024;' \
    '    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json;' \
    '' \
    '    location / {' \
    '        try_files $uri $uri/ /index.html;' \
    '    }' \
    '}' > /etc/nginx/conf.d/default.conf

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]