FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    cron \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt pyproject.toml ./

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt schedule

# Copy application code
COPY backend/ ./backend/
COPY scripts/ ./scripts/
# F8-13-013: no .env baking — configuration is injected via the
# compose environment blocks (docker-compose.ml-production.yml).

# Create necessary directories
RUN mkdir -p backend/ml_models backend/ml_logs backend/ml_registry data/training

# Set environment variables
ENV PYTHONPATH=/app
ENV ML_MODELS_PATH=/app/backend/ml_models
ENV ML_LOGS_PATH=/app/backend/ml_logs

# Run the ML scheduler
# F8-13-013: run as non-root, mirroring Dockerfile.backend.
RUN groupadd -r appuser && useradd -r -g appuser appuser \
    && chown -R appuser:appuser /app
USER appuser

CMD ["python3", "scripts/ml_scheduler.py", "--daemon"]